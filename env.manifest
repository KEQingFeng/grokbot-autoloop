# AutoLoop environment manifest — TAB-separated, no YAML (the cloud box has no
# guaranteed PyYAML, and a bot can read a TSV without a library).
# columns: 1 name	2 requirement	3 check	4 install_hint	5 why
# requirement:
#   required   engine cannot run without it -> bootstrap reports ok=false
#   sched      needed to wake the bot up on a timer (a native scheduled task works instead)
#   pr         needed only for the PR/remote steps; the engine degrades to branch+body
#   optional   speeds something up or enables one subcommand, never blocks a tick
#   worker     the headless agent CLI that actually writes the code (paid by its own key)
name	requirement	check	install_hint	why
python3	required	python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)'	apt-get install -y python3	runs scripts/autoloop.py; stdlib only, nothing to pip-install
git	required	git --version	apt-get install -y git	worktrees, branches, diffs, the push step — the engine shells out to it constantly
bash	required	bash --version	apt-get install -y bash	runs .autoloop/verify.sh (the gate) and each detached job wrapper
df	required	test -n "$(df -P . | tail -1)"	—	coreutils: the min_free_disk_mb gate reads it before any worktree is created
crontab	sched	command -v crontab	apt-get install -y cron && systemctl enable --now cron	wake-up driver. absent box cron is fine — use a Grok Bot native scheduled task instead
gh	pr	gh --version	official install script, or apt/brew	opens the PR, reads PR state, does the one reference search per round; absent -> branch is pushed and the body is printed for you
ssh	pr	command -v ssh	ssh-keygen -t ed25519 -C you@example.com -f ~/.ssh/id_ed25519_github, then add the pubkey in GitHub Settings→SSH keys	transports the push when origin is a git@ URL. Presence of the binary proves nothing about auth — `preflight` is the check that matters there, because it runs `git ls-remote` and an unregistered key fails exactly like no key at all
rg	optional	rg --version	apt-get install -y ripgrep	`suggest` code scan; falls back to grep -rn when missing
tar	optional	tar --version	apt-get install -y tar	`backup` snapshots .autoloop/ into the autoloop/state branch
node	optional	node --version	—	only if the repo under development is JS/TS; the gate runs whatever package manager the repo has
npm	optional	npm --version	—	JS/TS install step inside .autoloop/verify.sh
pytest	optional	python3 -m pytest --version	apt-get install -y python3-pytest	python repos: the TEST_CMD in the gate is usually this
worker	worker	test -n "$AUTOLOOP_WORKER_CMD"	—	the coding CLI: dsh / codex / claude / qoder / grok / aider / opencode. bootstrap prints which ones exist but never picks for you
